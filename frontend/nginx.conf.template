server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API calls to the backend container.
    # BACKEND_UPSTREAM is substituted at container start (official nginx image
    # runs envsubst over /etc/nginx/templates/*.template). Compose sets it to
    # http://backend:8080; for a host-run backend use host.docker.internal.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback - let react-router handle client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}