# Baked into the JS bundle at build time and read by the browser.
#
# Empty = same-origin: the site and the API share one host and the reverse
# proxy (nginx inside the frontend Docker image) forwards /api/ to the backend.
#
# For a plain local dev run against a bare backend:
#   VITE_API_URL=http://localhost:8080
# For a split deployment (e.g. Vercel frontend + remote API):
#   VITE_API_URL=https://api.example.com
VITE_API_URL=
