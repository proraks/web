DATABASE_URL=postgres://user:password@localhost:5432/dbname
# Argon2 hash of your admin password - generate with: cargo run --bin hash-password
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret for signing session cookies - generate with: openssl rand -hex 32
SESSION_SECRET=
PORT=8080
# Comma-separated list of frontend origins the browser may call this API from
# (CORS). Each entry can be an exact origin or contain a single `*` wildcard
# for sub-domains (e.g. https://*.ralfjka.sk — note the apex https://ralfjka.sk
# must be listed explicitly if you want it). Not needed when the frontend is
# served behind the nginx proxy (frontend/Dockerfile) since that is same-origin.
# CORS_ORIGIN=... is accepted as a single-origin alias.
CORS_ORIGINS=http://localhost:5173,http://localhost:8084,https://sub1.ralfjka.sk,https://*.ralfjka.sk
