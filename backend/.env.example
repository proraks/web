DATABASE_URL=mysql://user:password@dXXX.mysql.zonevs.eu:3306/dbname
# Argon2 hash of your admin password - generate with: cargo run --bin hash-password
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret for signing session cookies - generate with: openssl rand -hex 32
SESSION_SECRET=
PORT=8080
# Optional: frontend origin allowed by CORS when the browser calls this API
# directly (not needed when serving behind the nginx proxy in Docker).
CORS_ORIGIN=http://localhost:5173
